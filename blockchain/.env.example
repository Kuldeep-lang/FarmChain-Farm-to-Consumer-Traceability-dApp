# Sepolia deployment only. Use a dedicated DEVELOPMENT wallet funded with testnet ETH.
# NEVER commit a real .env file and NEVER use a wallet that holds real funds.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<your-key>
PRIVATE_KEY=
ETHERSCAN_API_KEY=
# Optional: also grant these wallets the admin role at deploy time (comma separated)
ADDITIONAL_ADMINS=
# Optional: public frontend URL (used in docs / QR codes)
FRONTEND_URL=http://localhost:5173
REPORT_GAS=false
