# ---------------------------------------------------------------
# FarmChain frontend configuration (copy to .env.local).
# Everything here is PUBLIC – it is bundled into the browser app.
# NEVER put private keys or Pinata secrets in this file.
# ---------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api

# 31337 = local Hardhat, 11155111 = Sepolia
VITE_CHAIN_ID=31337
# Read-only RPC used for public pages (consumers don't need a wallet)
VITE_RPC_URL=http://127.0.0.1:8545

# Public URL encoded into QR codes (defaults to the current origin)
VITE_PUBLIC_APP_URL=http://localhost:5173

# Contract addresses. Leave blank to use src/abi/deployments.json (written by the deploy script)
VITE_CONTRACT_ADDRESS_ROLE_MANAGER=
VITE_CONTRACT_ADDRESS_USER_REGISTRY=
VITE_CONTRACT_ADDRESS_PRODUCT_REGISTRY=
VITE_CONTRACT_ADDRESS_SUPPLY_CHAIN=
VITE_CONTRACT_ADDRESS_PAYMENT_ESCROW=
VITE_CONTRACT_ADDRESS_PAYMENT_TOKEN=

# Public IPFS gateway used to display images/documents
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
