{
  "name": "farmchain",
  "version": "1.0.0",
  "private": true,
  "description": "FarmChain - From Farm to Fork. Verified on Blockchain.",
  "scripts": {
    "install:all": "npm --prefix blockchain install && npm --prefix backend install && npm --prefix frontend install",
    "chain": "npm --prefix blockchain run node",
    "compile": "npm --prefix blockchain run compile",
    "deploy:local": "npm --prefix blockchain run deploy:local",
    "seed:local": "npm --prefix blockchain run seed:local",
    "deploy:sepolia": "npm --prefix blockchain run deploy:sepolia",
    "mongo:dev": "npm --prefix backend run mongo:dev",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "test": "npm --prefix blockchain test && npm --prefix backend test && npm --prefix frontend test",
    "test:contracts": "npm --prefix blockchain test",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "coverage": "npm --prefix blockchain run coverage"
  },
  "license": "MIT"
}
