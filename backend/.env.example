# ---------------------------------------------------------------
# FarmChain backend configuration. Copy to .env and fill in.
# NEVER commit the real .env file.
# ---------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Comma separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# MongoDB (local: `npm run mongo:dev` starts an embedded MongoDB on 27017, or use Docker/Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/farmchain

# Long random string used to sign API session tokens (wallet-signature login)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h

# ---------------- Blockchain ----------------
# Local Hardhat: http://127.0.0.1:8545 / 31337     Sepolia: https://sepolia.infura.io/v3/<key> / 11155111
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Contract addresses. Leave blank to use src/abi/deployments.json (written by the deploy script).
CONTRACT_ADDRESS_ROLE_MANAGER=
CONTRACT_ADDRESS_USER_REGISTRY=
CONTRACT_ADDRESS_PRODUCT_REGISTRY=
CONTRACT_ADDRESS_SUPPLY_CHAIN=
CONTRACT_ADDRESS_PAYMENT_ESCROW=
CONTRACT_ADDRESS_PAYMENT_TOKEN=

# ---------------- Event indexer ----------------
INDEXER_ENABLED=true
INDEXER_POLL_INTERVAL_MS=4000
# Blank = deployment start block from deployments.json
INDEXER_START_BLOCK=
# Blocks to wait before indexing (0 for Hardhat, 2-5 for Sepolia)
INDEXER_CONFIRMATIONS=0
# Max block range per eth_getLogs request (many Sepolia RPC providers limit this)
INDEXER_BLOCK_RANGE=500

# ---------------- IPFS ----------------
# pinata | kubo | none
IPFS_PROVIDER=pinata
# Pinata: create an API key (JWT) at https://app.pinata.cloud/developers/api-keys
PINATA_JWT=
# Your dedicated gateway domain, e.g. example-name.mypinata.cloud (optional)
PINATA_GATEWAY=
# Kubo (local IPFS node) API, used when IPFS_PROVIDER=kubo
KUBO_API_URL=http://127.0.0.1:5001
# Public gateway used to build file URLs
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
MAX_UPLOAD_MB=10
